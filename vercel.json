{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "qualitative-chemistry": {
      "root": "artifacts/qualitative-chemistry",
      "framework": "vite"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/mockups/(.*)", "destination": { "service": "mockup-sandbox" } },
    { "source": "/(.*)", "destination": { "service": "qualitative-chemistry" } }
  ]
}
